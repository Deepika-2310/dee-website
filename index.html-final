  <div style="margin-top:3rem; background:var(--deep-green); border-radius:4px; padding:2.5rem; text-align:center;">
    <p style="font-family:'Cormorant Garamond',serif; font-size:1.6rem; font-style:italic; font-weight:300; color:white; line-height:1.5;">
